{
  "name": "@nezha/nupi",
  "version": "0.1.0",
  "description": "NuPI - Pi execution subsystem for Nezha AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "pi": {
    "extensions": [
      "./extensions/nupi-tools.ts",
      "./extensions/nupi-autowork.ts"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node bin/nupi",
    "piano": "node bin/nupi"
  },
  "bin": {
    "nupi": "./bin/nupi",
    "piano": "./bin/nupi"
  },
  "keywords": [
    "nezha",
    "ai",
    "pi",
    "execution"
  ],
  "author": "emptist",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.1",
    "nezha": "^0.1.0",
    "pg": "^8.11.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.63.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emptist/nezha.git",
    "directory": "nupi"
  },
  "bugs": {
    "url": "https://github.com/emptist/nezha/issues"
  }
}
