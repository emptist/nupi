#!/bin/bash
# NuPI Launcher
# 
# 用法:
#   nupi              # 启动 NuPI 模式
#   nupi --help       显示帮助

set -e

NUPI_EXT="$HOME/.pi/agent/extensions/nupi-tools.ts"

show_help() {
    cat << EOF
NuPI Launcher - 本地 LLM 启动器

用法:
    nupi              启动 NuPI 模式
    nupi --help       显示帮助

示例:
    nupi              # 启动 NuPI (本地 LLM)
EOF
}

case "${1:-}" in
    -h|--help)
        show_help
        ;;
    *)
        echo "🟡 启动 NuPI 模式..."
        pi --no-extensions -e "$NUPI_EXT" "$@"
        ;;
esac
