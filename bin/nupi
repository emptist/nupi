#!/bin/bash
# NuPI Launcher
# 
# 用法:
#   nupi              # 启动 NuPI 模式
#   nupi --help       显示帮助

set -e

# Load OpenRouter API key from Keychain
export OPENROUTER_API_KEY=$(security find-generic-password -s "openrouter" -a "jk" -w 2>/dev/null)

resolve_link() {
    local target="$1"
    while [ -L "$target" ]; do
        local link_target="$(readlink "$target")"
        if [[ "$link_target" = /* ]]; then
            target="$link_target"
        else
            target="$(dirname "$target")/$link_target"
        fi
    done
    echo "$target"
}

SCRIPT_PATH="$(resolve_link "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
NUPI_EXT="$PROJECT_DIR/extensions/nupi-tools.ts"

show_help() {
    cat << EOF
NuPI Launcher - 本地 LLM 启动器

用法:
    nupi              启动 NuPI 模式
    nupi --help       显示帮助

示例:
    nupi              # 启动 NuPI (本地 LLM)
EOF
}

case "${1:-}" in
    -h|--help)
        show_help
        ;;
    --list-models)
        shift
        pi --list-models --provider openrouter "$@"
        ;;
    *)
        echo "🟡 启动 NuPI 模式..."
        pi --no-extensions -e "$NUPI_EXT" "$@"
        ;;
esac
